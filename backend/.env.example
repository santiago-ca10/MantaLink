DATABASE_URL=postgres://mantalink:mantalink@localhost:5432/mantalink
JWT_SECRET=cambia-esto-en-produccion
PORT=3000
# Si es "true", toda oferta nueva queda PENDIENTE hasta que el admin la apruebe (CU1 postcondición)
MODERACION_ACTIVA=true
# Solo para desarrollo: credenciales del admin que crea el seed
ADMIN_CORREO=admin@mail.com
ADMIN_PASSWORD=admin
# Carpeta donde se guardan las fotos subidas (en Docker ya viene configurada)
UPLOADS_DIR=./uploads

# --- Recuperar contraseña (CU5) ---
# Dirección pública de la web: se usa para armar el enlace del correo
APP_URL=http://localhost:5173
# Correo saliente. Si dejas SMTP_HOST vacío (desarrollo), el correo se imprime en la consola del backend.
# Ejemplo Gmail: crea una "contraseña de aplicación" en tu cuenta de Google y úsala en SMTP_PASS.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tucorreo@gmail.com
# SMTP_PASS=contraseña-de-aplicacion
# SMTP_FROM=MantaLink <tucorreo@gmail.com>
